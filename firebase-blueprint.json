{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile data",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "HistoryItem": {
      "title": "HistoryItem",
      "description": "Scanned problem and solution record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "problemText": { "type": "string" },
        "solution": { "type": "string" },
        "steps": { "type": "array", "items": { "type": "string" } },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "userId", "problemText"]
    }
  }
}
